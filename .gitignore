gt-speedup*.md
ns_check_out*.txt

# Local launcher scripts (auto-commit picks these up otherwise)
.run_*.R

# Local backups (timestamped or labelled .bak_*)
*.bak_*

# Rendered vignette outputs (built artifacts)
vignettes/*.html

# Local R CMD check workdirs
_check*/

# Knit artifacts from the R Journal build
paper/rjournal/*.log

# R Journal comparator corpus (regenerate with the r-journal skill:
# rj_style_metrics.py --pull refs --extract refs). Kept out of the tree so it
# cannot be swept into the 10 MB submission archive.
paper/rjournal/refs/
